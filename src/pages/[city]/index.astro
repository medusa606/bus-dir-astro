---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import TieredListings from '../../components/TieredListings.astro';
import { supabase } from '../../lib/supabase.js';
import { slugToTitle, getEmoji, normaliseCategory } from '../../utils/helpers.js';

const { city } = Astro.params;
const cityTitle = slugToTitle(city);

const ACTIVE = 'status.not.in.(closed,unverified),status.is.null';
const PAGE_SIZE = 1000;

// Listings with no address are excluded everywhere on the site, so they must
// not be counted or linked here either.
// Area and category links are this city's crawl paths into every listing, so
// they must be derived from ALL rows. A single request stops at the PostgREST
// 1000-row cap, which silently hid areas and categories that only appear
// further down the table. Select just the two slug columns to keep it cheap.
const slugRows: { area_slug: string | null; category_slug: string | null }[] = [];
for (let page = 0; ; page++) {
    const { data: chunk } = await supabase
        .from('listings')
        .select('area_slug, category_slug')
        .eq('city_slug', city)
        .or(ACTIVE)
        .not('address', 'is', null)
        .range(page * PAGE_SIZE, (page + 1) * PAGE_SIZE - 1);
    if (!chunk?.length) break;
    slugRows.push(...chunk);
    if (chunk.length < PAGE_SIZE) break;
}

const totalListings = slugRows.length;

const areaCounts: Record<string, number> = {};
slugRows.forEach(l => { if (l.area_slug) areaCounts[l.area_slug] = (areaCounts[l.area_slug] || 0) + 1; });

const categoryCounts: Record<string, number> = {};
slugRows.forEach(l => {
    const cat = normaliseCategory(l.category_slug);
    if (cat) categoryCounts[cat] = (categoryCounts[cat] || 0) + 1;
});

// The card grid below is a sample, not an index — rendering thousands of cards
// would bloat the page. Area and category pages are the real per-listing hubs.
const CARD_LIMIT = 240;
const { data: cardListings } = await supabase
    .from('listings')
    .select('*')
    .eq('city_slug', city)
    .or(ACTIVE)
    .not('address', 'is', null)
    .limit(CARD_LIMIT);
const listings = cardListings || [];

// Top 10 areas by listing count, rest alphabetically
const allAreaEntries = Object.entries(areaCounts) as [string, number][];
const topAreas = [...allAreaEntries].sort((a, b) => b[1] - a[1]).slice(0, 10);
const topAreaSlugs = new Set(topAreas.map(([a]) => a));
const moreAreas = allAreaEntries.filter(([a]) => !topAreaSlugs.has(a)).sort((a, b) => a[0].localeCompare(b[0]));

const sortedCategories = Object.entries(categoryCounts).sort((a, b) => a[0].localeCompare(b[0]));
---

<BaseLayout title={`People in ${cityTitle}`} description={`Discover independent makers, traders, and service providers in ${cityTitle}.`}>

<section style="padding: var(--space-3xl) 0 var(--space-xl); background: linear-gradient(135deg, var(--parchment) 0%, var(--blush-light) 100%);">
    <div class="container">
        <Breadcrumbs crumbs={[{ label: cityTitle }]} />
        <h1 style="margin-top: var(--space-lg);">People in {cityTitle}</h1>
        <div class="divider"></div>
        <p class="text-secondary" style="font-size: 1.05rem; max-width: 550px;">
            {totalListings} people across {Object.keys(areaCounts).length} areas
            — every one of them here because they deserve to be.
        </p>
    </div>
</section>

<!-- Areas -->
<section class="section">
    <div class="container">
        <div class="section-header">
            <h2>Browse by area</h2>
            <div class="divider"></div>
            <p>Select a neighbourhood to see what's nearby.</p>
        </div>
        <div class="areas-grid">
            {topAreas.map(([area, count]) => (
                <a href={`/${city}/${area}`} class="area-card">
                    <div>
                        <h3 style="text-transform: capitalize;">{area.replace(/-/g, ' ')}</h3>
                        <p>{count} {count === 1 ? 'person' : 'people'}</p>
                    </div>
                </a>
            ))}
        </div>
        {moreAreas.length > 0 && (
            <div class="area-pills">
                {moreAreas.map(([area, count]) => (
                    <a href={`/${city}/${area}`} class="area-pill">
                        <span style="text-transform: capitalize;">{area.replace(/-/g, ' ')}</span>
                        <span class="area-pill__count">{count}</span>
                    </a>
                ))}
            </div>
        )}
    </div>
</section>

<!-- Categories -->
<section class="section" style="background: var(--white);">
    <div class="container">
        <div class="section-header">
            <h2>Browse by category</h2>
            <div class="divider"></div>
            <p>Find the right person for what you need.</p>
        </div>
        <div class="category-grid">
            {sortedCategories.map(([cat, count]) => (
                <a href={`/${city}/${cat}`} class="category-card">
                    <div class="category-card__icon">{getEmoji(cat)}</div>
                    <div class="category-card__text">
                        <h4>{slugToTitle(cat)}</h4>
                        <p>{count} {count === 1 ? 'person' : 'people'}</p>
                    </div>
                </a>
            ))}
        </div>
    </div>
</section>

<!-- All Listings Tiered -->
<section class="section">
    <div class="container">
        <div class="section-header">
            <h2>A look at {cityTitle}</h2>
            <div class="divider"></div>
        </div>
        <TieredListings listings={listings} />
    </div>
</section>

<!-- CTA -->
<section class="section">
    <div class="container">
        <div class="cta-banner">
            <h2>Doing great work in {cityTitle}?</h2>
            <p>locale is for independent people who care about their craft. If that's you, we'd love to include you.</p>
            <a href="/apply" class="btn btn--accent">Apply to be listed</a>
        </div>
    </div>
</section>

</BaseLayout>
